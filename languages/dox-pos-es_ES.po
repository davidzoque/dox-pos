msgstr "Escribe un código."

msgid "Only letters, numbers, dots and hyphens."
msgstr "Solo letras, números, puntos y guiones."

msgid "SKU %1$s is already used by %2$s."
msgstr "El código %1$s ya lo usa %2$s."

msgid "The photo is larger than the server allows (%s)."
msgstr "La foto pesa más de lo que admite el servidor (%s)."

msgid "The photo did not upload completely. Please try again."
msgstr "La foto no llegó completa. Vuelve a intentarlo."

msgid "The store cannot read that file as a photo. JPG, PNG, WebP and HEIC work."
msgstr "Ese archivo no es una foto que la tienda sepa leer. Valen JPG, PNG, WebP y HEIC."

msgid "The photo could not be added to the media library."
msgstr "No se pudo registrar la foto en la biblioteca."

msgid "This server cannot read HEIC photos. Send the photo as a JPG."
msgstr "Este servidor no sabe leer fotos HEIC. Manda la foto como JPG."

