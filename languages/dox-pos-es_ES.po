msgid "Only administrators and shop managers can create products."
msgstr "Crear productos es cosa de administradores y gerentes de tienda."

msgid "Your session expired. Please sign in again."
msgstr "Tu sesión caducó. Vuelve a entrar."

msgid "Your user does not have access to the register."
msgstr "Tu usuario no tiene acceso a la caja."

msgid "No photo was received."
msgstr "No llegó ninguna foto."

msgid "One size"
msgstr "Talla única"

msgid "Any"
msgstr "Cualquiera"

msgid "This server cannot read Excel files: the PHP zip extension is missing."
msgstr "Este servidor no puede leer archivos de Excel: le falta la extensión zip de PHP."

msgid "That file is not an Excel file (.xlsx)."
msgstr "Ese archivo no es un Excel (.xlsx)."

msgid "The sheet was not found inside the Excel file."
msgstr "No se encontró la hoja dentro del Excel."

msgid "The Excel sheet could not be read."
msgstr "No se pudo leer la hoja del Excel."

msgid "Only administrators and shop managers can upload costs."
msgstr "Los costos los cargan administradores y gerentes."

