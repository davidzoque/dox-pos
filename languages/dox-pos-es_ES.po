msgstr "La ruta /%s/ ya la usa otra página."

msgid "The previous one was kept."
msgstr "Se dejó la anterior."

msgid "At least one sales channel is needed. The default ones were restored."
msgstr "Hace falta al menos un canal de venta. Se pusieron los de fábrica."

msgid "At least one payment method is needed. All of them were turned on."
msgstr "Hace falta al menos una forma de pago. Se activaron todas."

msgid "The %s link is not valid: it has to start with https://"
msgstr "El enlace de %s no vale: tiene que empezar por https://"

